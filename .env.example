# ─────────────────────────────────────────────────────────────────────────────
# NetOpsAI — Environment Variables
# Copy this file to .env and fill in real values before starting.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netopsai
DB_USER=netopsai
DB_PASSWORD=change_me_strong_password

# n8n uses the same Postgres server but a separate database
N8N_DB_NAME=n8n

# ── Express Backend ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Optional: set a random string to enable API key authentication.
# Leave empty to run in dev mode (no auth required).
API_KEY=

# URL of the NETOPS-01 Orchestrator n8n webhook
# Default when running with Docker Compose:
N8N_WEBHOOK_URL=http://n8n:5678/webhook/netopsai/alarm

# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000

# ── React Frontend ────────────────────────────────────────────────────────────
# '/api' works with the Docker/nginx setup and the Vite dev proxy
VITE_API_URL=/api
VITE_API_KEY=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
# Host port for the n8n UI (container always listens on 5678)
N8N_HOST_PORT=5678
N8N_PROTOCOL=http
N8N_EXTERNAL_WEBHOOK_URL=http://localhost:5678

# ── Docker Compose port mapping ───────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── Misc ──────────────────────────────────────────────────────────────────────
TIMEZONE=UTC

# ─────────────────────────────────────────────────────────────────────────────
# n8n Credentials (set in the n8n UI — NOT here)
# ─────────────────────────────────────────────────────────────────────────────
# Create the following credentials in the n8n UI:
#
#   1. Credential name : netopsai-openai
#      Type            : OpenAI API
#      API Key         : <your OpenAI / OpenRouter / proxy key>
#      Base URL        : https://api.openai.com/v1  (change for proxy)
#
#   2. Credential name : netopsai-postgres
#      Type            : Postgres
#      Host            : postgres  (or localhost if running locally)
#      Port            : 5432
#      Database        : netopsai
#      User            : netopsai
#      Password        : <same as DB_PASSWORD>
#
#   3. Credential name : netopsai-telegram  (optional — only for alerts)
#      Type            : Telegram API
#      Access Token    : <your Telegram bot token>
#
# ─────────────────────────────────────────────────────────────────────────────
